# Database
DATABASE_URL=postgresql+asyncpg://surveillance:surveillance@postgres:5432/market_surveillance
SYNC_DATABASE_URL=postgresql://surveillance:surveillance@postgres:5432/market_surveillance

# Redis
REDIS_URL=redis://redis:6379/0

# App
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true
LOG_LEVEL=INFO

# Binance
BINANCE_WS_URL=wss://stream.binance.com:9443/ws
DEFAULT_SYMBOLS=btcusdt,ethusdt

# Scoring weights
WEIGHT_RULE=0.35
WEIGHT_ML=0.30
WEIGHT_CUSTOM=0.35

# ML
ML_MODEL_DIR=models
ISOLATION_FOREST_CONTAMINATION=0.05
AUTOENCODER_EPOCHS=50
AUTOENCODER_HIDDEN_DIM=32
AUTOENCODER_LATENT_DIM=16

# Feature windows
FEATURE_WINDOW_SECONDS=60
ROLLING_WINDOW_SIZE=100
